# Firebase Web app config. These NEXT_PUBLIC values are shipped to the browser,
# so they are identifiers/configuration, NOT server secrets. Protect data with Firebase Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# YouTube Data API v3 Key for Admin In-Game YouTube Song Search & Broadcast
NEXT_PUBLIC_YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
